# inftune-workload — Guidellm benchmark runner + network debugging
# Runs as a persistent pod, receives benchmark commands via kubectl exec.

# BLIS (Blackbox Inference Simulator) — CPU-only discrete-event simulator
# for llm-d deployments (real llm-d router embedded, vLLM 0.32.0 cost models).
# Static binary: CGO_ENABLED=0 so it runs on any linux/amd64 host regardless
# of glibc. Pinned to the commit validated against the ServeIt integration;
# bump deliberately — Result schema and catalog coverage move with upstream.
FROM golang:1.27.2 AS blis-builder
RUN git clone https://github.com/inference-sim/inference-sim.git /src && \
    git -C /src checkout c79c745 && \
    cd /src && CGO_ENABLED=0 GOFLAGS=-trimpath go build -o /blis main.go

FROM registry.access.redhat.com/ubi9/ubi:9.4
ENV LANG="C.UTF-8" LC_ALL="C.UTF-8" PYTHONUNBUFFERED=1

# System tools — benchmark + network debugging
RUN \
    dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-$(rpm -E %{rhel}).noarch.rpm && \
    dnf install -y \
        python3.11 python3.11-devel \
        procps jq wget \
        iputils net-tools bind-utils \
        ethtool nmap-ncat \
    && \
    dnf install -y traceroute rdma-core libibverbs-utils infiniband-diags qperf iperf3 || true && \
    python3.11 -m ensurepip --upgrade && \
    python3.11 -m pip install --upgrade pip setuptools --no-cache-dir && \
    dnf clean all && rm -rf /var/cache/dnf/* && \
    ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.11 /usr/bin/python && \
    ln -sf /usr/bin/pip3.11 /usr/bin/pip3 && \
    ln -sf /usr/bin/pip3.11 /usr/bin/pip

# Python deps — guidellm + tokenizer (for dataset generation)
# guidellm from main branch (first_prompt_tokens, prefix_buckets, branches support)
COPY docker/guidellm-main.zip /tmp/guidellm-main.zip
COPY docker/scripts/patch_guidellm_corpus.py /tmp/patch_guidellm_corpus.py
COPY docker/scripts/patch_guidellm_adapter_header.py /tmp/patch_guidellm_adapter_header.py
COPY docker/scripts/patch_guidellm_conversation_pin.py /tmp/patch_guidellm_conversation_pin.py
RUN python3.11 -m pip install --no-cache-dir \
    /tmp/guidellm-main.zip \
    transformers \
    requests \
    httpx \
    PyYAML \
    huggingface_hub \
    && python3.11 /tmp/patch_guidellm_corpus.py \
    && python3.11 /tmp/patch_guidellm_adapter_header.py \
    && python3.11 /tmp/patch_guidellm_conversation_pin.py \
    && rm -f /tmp/guidellm-main.zip /tmp/patch_guidellm_corpus.py /tmp/patch_guidellm_adapter_header.py /tmp/patch_guidellm_conversation_pin.py

# kubectl (multi-arch)
RUN KUBECTL_VERSION="1.30.2" && \
    ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') && \
    curl -sLo /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl" && \
    chmod +x /usr/local/bin/kubectl

WORKDIR /app

# Bundle wikitext-103 corpus for corpus-mode dataset generation
# Real prose (not word salad) — needed for speculative decoding benchmarks.
# datasets stays installed: guidellm imports it at runtime (guidellm.data.schemas.base).
COPY docker/scripts/prepare_corpus.py /tmp/prepare_corpus.py
RUN python3.11 -m pip install --no-cache-dir datasets \
    && python3.11 /tmp/prepare_corpus.py --output /app/corpus/wikitext-103.txt \
    && rm -f /tmp/prepare_corpus.py

# Add results parser script
COPY docker/scripts/parse_guidellm.py /usr/local/bin/parse_guidellm
RUN chmod +x /usr/local/bin/parse_guidellm

# Add dataset generation scripts
COPY docker/scripts/generate_dataset.py /usr/local/bin/generate_dataset
RUN chmod +x /usr/local/bin/generate_dataset
COPY docker/scripts/generate_turn_dataset.py /usr/local/bin/generate_turn_dataset
RUN chmod +x /usr/local/bin/generate_turn_dataset

# Add WekaTrace (agentic traces) dataset converter + bundled traces
COPY docker/scripts/generate_wekatrace_dataset.py /usr/local/bin/generate_wekatrace_dataset
RUN chmod +x /usr/local/bin/generate_wekatrace_dataset

# Bundle the WekaTrace agentic traces (10 curated Claude Code sessions,
# ~430 requests, ISL 448-500k, 97-99% hash-block prefix sharing).
# These are REAL production agentic sessions from SemiAnalysis traces.
COPY docker/data/cc-traces-subset.jsonl /app/traces/cc-traces-weka.jsonl

# BLIS simulator from the builder stage (see blis-builder above).
# Catalog + registry + router reference configs are embedded in the binary.
COPY --from=blis-builder /blis /usr/local/bin/blis

# Keep alive — the server does kubectl exec to run guidellm commands
CMD ["sleep", "infinity"]
