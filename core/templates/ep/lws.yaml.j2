apiVersion: leaderworkerset.x-k8s.io/v1
kind: LeaderWorkerSet
metadata:
  name: {{ test_id }}-ep
  namespace: {{ namespace }}
  labels:
    app: llm-d
    component: inftune-test
    test-id: {{ test_id }}
    architecture: ep
spec:
  replicas: {{ replicas }}
  leaderWorkerTemplate:
    size: 1
    workerTemplate:
      metadata:
        labels:
          llm-d.ai/inferenceServing: "true"
          llm-d.ai/inference-serving: "true"
          llm-d.ai/model: {{ model_name_label }}
          llm-d.ai/role: ep
          llm-d.ai/guide: inftune-ep
          llm-d.ai/test-id: {{ test_id }}
      spec:
        serviceAccountName: llm-d-modelserver
        tolerations:
          - key: node.kubernetes.io/disk-pressure
            operator: Exists
            effect: NoSchedule
          - key: node.kubernetes.io/memory-pressure
            operator: Exists
            effect: NoSchedule
        volumes:
          - name: dshm
            emptyDir:
              medium: Memory
              sizeLimit: 2Gi
          - name: hf-cache
            persistentVolumeClaim:
              claimName: {{ pvc_name }}
          - name: jit-cache
            emptyDir: {}
          - name: discovery-script
            configMap:
              name: rdma-discovery-script
              defaultMode: 0755
        containers:
          - name: vllm
            image: {{ image }}
            securityContext:
              capabilities:
                add:
                  - IPC_LOCK
                  - SYS_RAWIO
                  - SYS_RESOURCE
              runAsGroup: 0
              runAsUser: 0
            imagePullPolicy: Always
            command:
              - /bin/bash
              - -c
            args:
              - |-
                # Clear /dev/shm on start to prevent running out of space when crashes occur
                find /dev/shm -type f -delete

                # Pin to allocated GPUs (privileged pods see all host GPUs)
                if [ -d /var/run/nvidia-container-devices ]; then
                  GPU_INDICES=""
                  for uuid in $(ls /var/run/nvidia-container-devices/); do
                    idx=$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader | grep "$uuid" | cut -d',' -f1 | tr -d ' ')
                    [ -n "$idx" ] && GPU_INDICES="${GPU_INDICES:+$GPU_INDICES,}$idx"
                  done
                  if [ -n "$GPU_INDICES" ]; then
                    export CUDA_VISIBLE_DEVICES="$GPU_INDICES"
                    echo "--- CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES ---"
                  fi
                fi

                # Source RDMA discovery script if available
                if [ -f /scripts/discover_ib_hca.sh ]; then
                  source /scripts/discover_ib_hca.sh
                  echo "--- Loaded RDMA environment ---"
                fi

                echo "========================================="
                echo "Inftune Studio Test: {{ test_id }}"
                echo "Architecture: EP (Eager Prefill)"
                echo "Model: {{ model_name }}"
                echo "TP: {{ tensor_parallelism }}"
                echo "Max Model Len: {{ max_model_len or 'vLLM default' }}"
                echo "========================================="

                # Set unlimited locked memory for RDMA/NVSHMEM
                ulimit -l unlimited || true

                #################
                # RUN vLLM with Eager Prefill (EP)
                #################
                exec vllm serve \
                  {{ model_name }} \
                  --port 8000 \
{% if trust_remote_code %}                  --trust-remote-code \
{% endif %}                  --tensor-parallel-size {{ tensor_parallelism }} \
{% if pipeline_parallel_size %}                  --pipeline-parallel-size {{ pipeline_parallel_size }} \
{% endif %}                  --kv_transfer_config '{"kv_connector":"NixlConnector","kv_role":"kv_both","kv_load_failure_policy":"fail"}' \
{% if enable_expert_parallel %}                  --enable-expert-parallel \
                  --enable-dbo \
                  --enable-eplb \
                  --eplb-config '{"window_size":"1000","step_interval":"3000","num_redundant_experts":"32","log_balancedness":"False"}' \
                  --moe-backend deep_gemm \
                  --all2all-backend deepep_high_throughput \
{% endif %}{% if max_model_len %}                  --max-model-len {{ max_model_len }} \
{% endif %}{% if gpu_memory_utilization %}                  --gpu-memory-utilization {{ gpu_memory_utilization }} \
{% endif %}{% if enable_prefix_caching %}                  --enable-prefix-caching \
{% endif %}{% if disable_custom_all_reduce %}                  --disable-custom-all-reduce \
{% endif %}{% if dtype %}                  --dtype {{ dtype }} \
{% endif %}{% if kv_cache_dtype %}                  --kv-cache-dtype {{ kv_cache_dtype }} \
{% endif %}{% if max_num_batched_tokens %}                  --max-num-batched-tokens {{ max_num_batched_tokens }} \
{% endif %}{% if max_num_seqs %}                  --max-num-seqs {{ max_num_seqs }} \
{% endif %}{% if speculative_method %}                  --speculative-config.method {{ speculative_method }} \
                  --speculative-config.num_speculative_tokens {{ speculative_num_tokens | default(3) }} \
{% endif %}{% if enable_auto_tool_choice %}                  --enable-auto-tool-choice \
{% endif %}{% if tool_call_parser %}                  --tool-call-parser {{ tool_call_parser }} \
{% endif %}{% if reasoning_parser %}                  --reasoning-parser {{ reasoning_parser }} \
{% endif %}{% if chat_template_content_format %}                  --chat-template-content-format {{ chat_template_content_format }} \
{% endif %}{% if extra_vllm_args %}                  {{ extra_vllm_args }} \
{% endif %}                  --disable-access-log-for-endpoints=/health,/metrics

            env:
              - name: HF_TOKEN
                valueFrom:
                  secretKeyRef:
                    name: llm-d-hf-token
                    key: HF_TOKEN
                    optional: true
              - name: HF_HOME
                value: "/model-cache/huggingface"
              - name: HF_HUB_CACHE
                value: "/model-cache/huggingface"
              - name: NCCL_IB_HCA
                value: "{{ nccl_ib_hca }}"
              - name: NCCL_SOCKET_IFNAME
                value: "eth0"
              - name: GLOO_SOCKET_IFNAME
                value: "eth0"
              - name: VLLM_SKIP_P2P_CHECK
                value: "1"
              - name: NVIDIA_GDRCOPY
                value: "enabled"
              - name: VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS
                value: "1"
              - name: VLLM_RANDOMIZE_DP_DUMMY_INPUTS
                value: "1"
              - name: NVSHMEM_REMOTE_TRANSPORT
                value: "ibgda"
              - name: NVSHMEM_IB_ENABLE_IBGDA
                value: "true"
              - name: NVSHMEM_BOOTSTRAP_UID_SOCK_IFNAME
                value: "eth0"
              - name: TRITON_LIBCUDA_PATH
                value: /usr/lib64
              - name: VLLM_NIXL_SIDE_CHANNEL_HOST
                valueFrom:
                  fieldRef:
                    fieldPath: status.podIP
              - name: VLLM_LOGGING_LEVEL
                value: "{{ 'DEBUG' if vllm_debug_logs else 'ERROR' }}"
              - name: CUDA_CACHE_PATH
                value: /var/cache/vllm/cuda
              - name: CCACHE_DIR
                value: /var/cache/vllm/ccache
              - name: VLLM_CACHE_ROOT
                value: /var/cache/vllm/vllm
              - name: FLASHINFER_WORKSPACE_BASE
                value: /var/cache/vllm/flashinfer
            ports:
              - containerPort: 8000
                name: http
                protocol: TCP
            resources:
              limits:
                {{ gpu_resource_key }}: "{{ gpu_count }}"
                {% for r in extra_device_resources %}
                {{ r.key }}: "{{ r.value }}"
                {% endfor %}
            volumeMounts:
              - name: dshm
                mountPath: /dev/shm
              - name: hf-cache
                mountPath: /model-cache
              - name: jit-cache
                mountPath: /var/cache/vllm
              - name: discovery-script
                mountPath: /scripts
