apiVersion: batch/v1
kind: Job
metadata:
  name: {{ job_name | default('serveit-model-download') }}
  namespace: {{ namespace }}
  labels:
    app: llm-d
    component: serveit-benchmark
    test-id: {{ test_id }}
  annotations:
    description: "Model download job for {{ model_name }}"
spec:
  backoffLimit: 3
  ttlSecondsAfterFinished: 10
  template:
    metadata:
      labels:
        app: llm-d
        component: serveit-benchmark
        job: model-download
        test-id: {{ test_id }}
    spec:
      restartPolicy: OnFailure
      containers:
        - name: model-downloader
          image: {{ image | default('registry.access.redhat.com/ubi9/python-311:latest') }}
          imagePullPolicy: Always
          command:
            - stdbuf
            - -oL
            - /bin/bash
            - -c
          args:
            - |
              set -e
              echo "========================================="
              echo "ServeIt Studio Per-Node Model Download"
              echo "Model: {{ model_name }}"
              echo "NFS Mounts: {{ node_nfs_pvcs | length }}"
              echo "========================================="

              PRIMARY="/nfs-{{ node_nfs_pvcs[0].suffix }}/huggingface"
              MODEL_CACHE_NAME="models--{{ model_name | replace('/', '--') }}"

              # Always run snapshot_download — HuggingFace verifies integrity, skips if complete
              echo "📥 Verifying/downloading {{ model_name }} on nfs-{{ node_nfs_pvcs[0].suffix }}..."

              pip3 install --quiet huggingface_hub

                export HF_HUB_DISABLE_PROGRESS_BARS=1

                python3 -u <<'PYTHON_EOF'
              from huggingface_hub import snapshot_download, HfApi
              import os, sys, time, threading
              from pathlib import Path

              sys.stdout.reconfigure(line_buffering=True)
              sys.stderr.reconfigure(line_buffering=True)

              model_id = '{{ model_name }}'
              cache_dir = '/nfs-{{ node_nfs_pvcs[0].suffix }}/huggingface'
              token = os.getenv('HF_TOKEN')
              if not token or not token.strip():
                  token = None

              print(f'\n🔄 Downloading model: {model_id}', flush=True)
              print(f'📁 Cache directory: {cache_dir}\n', flush=True)

              try:
                  print('📊 Fetching model metadata...', flush=True)
                  api = HfApi(token=token)
                  try:
                      model_info = api.model_info(model_id)
                      files = [f for f in model_info.siblings if f.rfilename]
                      print(f'📦 Model contains {len(files)} files', flush=True)
                      total_size = sum(f.size for f in files if f.size)
                      files_with_size = sum(1 for f in files if f.size)
                      if files_with_size > 0:
                          print(f'💾 Total size: ~{total_size / (1024**3):.2f} GB\n', flush=True)
                      else:
                          print(f'💾 Total size: Unknown\n', flush=True)
                  except Exception as e:
                      print(f'⚠️ Could not fetch metadata: {e}', flush=True)
                      files = []

                  start_time = time.time()
                  print('📥 Starting download...\n', flush=True)

                  download_complete = threading.Event()
                  expected_files = len(files)
                  model_cache_name = 'models--' + model_id.replace('/', '--')

                  def track_progress():
                      last_count = 0
                      while not download_complete.is_set():
                          time.sleep(3)
                          try:
                              blobs_path = Path(cache_dir) / model_cache_name / 'blobs'
                              if blobs_path.exists():
                                  file_count = sum(1 for _ in blobs_path.iterdir() if _.is_file())
                                  if file_count > last_count and expected_files > 0:
                                      percent = min(100, int(100 * file_count / expected_files))
                                      print(f'📥 Downloaded: {file_count}/{expected_files} files ({percent}%)', flush=True)
                                      last_count = file_count
                          except Exception:
                              pass

                  if expected_files > 0:
                      progress_thread = threading.Thread(target=track_progress, daemon=True)
                      progress_thread.start()

                  snapshot_download(
                      repo_id=model_id,
                      cache_dir=cache_dir,
                      token=token if token else None,
                      max_workers=4,
                      local_files_only=False
                  )
                  download_complete.set()

                  elapsed = int(time.time() - start_time)
                  print(f'\n✅ Download complete! (took {elapsed}s)', flush=True)

              except Exception as e:
                  print(f'\n❌ Error downloading model: {e}', flush=True)
                  import traceback
                  traceback.print_exc()
                  sys.exit(1)
              PYTHON_EOF

                echo ""
                echo "📊 Primary NFS size:"
                du -sh "/nfs-{{ node_nfs_pvcs[0].suffix }}/huggingface/$MODEL_CACHE_NAME"

              echo ""
              echo "========================================="
              echo "📋 Distributing model to {{ node_nfs_pvcs | length - 1 }} remaining nodes"
              echo "========================================="

              echo "📦 Targets: {% for nfs in node_nfs_pvcs[1:] %}nfs-{{ nfs.suffix }}{% if not loop.last %}, {% endif %}{% endfor %}"
              echo "⏳ Copying to {{ node_nfs_pvcs | length - 1 }} nodes in parallel..."
              PRIMARY_SIZE=$(du -sb "$PRIMARY/$MODEL_CACHE_NAME" | cut -f1)
              PRIMARY_SIZE_H=$(du -sh "$PRIMARY/$MODEL_CACHE_NAME" | cut -f1)
              COPY_START=$(date +%s)
              PIDS=""
{% for nfs in node_nfs_pvcs[1:] %}
              rsync -rL --size-only --no-perms --no-owner --no-group "$PRIMARY/$MODEL_CACHE_NAME/" "/nfs-{{ nfs.suffix }}/huggingface/$MODEL_CACHE_NAME/" 2>/dev/null &
              PIDS="$PIDS $!"
{% endfor %}

              # Poll until all PIDs are gone
              while true; do
                ALIVE=0
                for p in $PIDS; do kill -0 $p 2>/dev/null && ALIVE=$((ALIVE+1)); done
                [ $ALIVE -eq 0 ] && break
                DONE=0
                STATUS=""
{% for nfs in node_nfs_pvcs[1:] %}
                BYTES=$(du -sb "/nfs-{{ nfs.suffix }}/huggingface/$MODEL_CACHE_NAME" 2>/dev/null | cut -f1)
                if [ "${BYTES:-0}" -ge "$PRIMARY_SIZE" ] 2>/dev/null; then
                  DONE=$((DONE + 1))
                  STATUS="$STATUS {{ nfs.suffix }}:✅"
                else
                  PCT=0
                  [ "$PRIMARY_SIZE" -gt 0 ] 2>/dev/null && PCT=$((BYTES * 100 / PRIMARY_SIZE))
                  STATUS="$STATUS {{ nfs.suffix }}:${PCT}%"
                fi
{% endfor %}
                ELAPSED=$(( $(date +%s) - COPY_START ))
                echo "📊 Copy progress (${ELAPSED}s): ${DONE}/{{ node_nfs_pvcs | length - 1 }} done |$STATUS"
                sleep 30
              done
              wait $PIDS 2>/dev/null
              TOTAL_ELAPSED=$(( $(date +%s) - COPY_START ))
              echo "✅ All parallel copies finished (${TOTAL_ELAPSED}s) — ${PRIMARY_SIZE_H} × {{ node_nfs_pvcs | length - 1 }} nodes"

              echo ""
              echo "========================================="
              echo "📋 Verifying copies (model files present)"
              echo "========================================="
              FAIL=0
{% for nfs in node_nfs_pvcs[1:] %}
              DST="/nfs-{{ nfs.suffix }}/huggingface"
              SNAP=$(ls -d "$DST/$MODEL_CACHE_NAME"/snapshots/*/ 2>/dev/null | head -1)
              MFILES=$(find "$SNAP" -maxdepth 1 \( -name "*.safetensors" -o -name "*.bin" -o -name "*.pt" \) 2>/dev/null | wc -l)
              SIZE=$(du -sh "$DST/$MODEL_CACHE_NAME" 2>/dev/null | cut -f1)
              if [ "$MFILES" -gt 0 ] 2>/dev/null; then
                echo "✅ nfs-{{ nfs.suffix }}: ${MFILES} model files, ${SIZE}"
              else
                echo "❌ nfs-{{ nfs.suffix }}: no model files found"
                FAIL=1
              fi
{% endfor %}
              if [ "$FAIL" = "1" ]; then
                echo "❌ Some copies failed verification"
                exit 1
              fi
              echo ""
              echo "========================================="
              echo "✅ Model distributed and verified on all {{ node_nfs_pvcs | length }} nodes"
              echo "========================================="
          env:
            {% if hf_token %}
            - name: HF_TOKEN
              value: "{{ hf_token }}"
            {% else %}
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: llm-d-hf-token
                  key: HF_TOKEN
                  optional: true
            {% endif %}
            - name: HF_HUB_OFFLINE
              value: "0"
            - name: HF_HUB_CACHE
              value: /nfs-{{ node_nfs_pvcs[0].suffix }}/huggingface
            - name: HF_HOME
              value: /nfs-{{ node_nfs_pvcs[0].suffix }}/huggingface
          volumeMounts:
{% for nfs in node_nfs_pvcs %}
            - name: nfs-{{ nfs.suffix }}
              mountPath: /nfs-{{ nfs.suffix }}
{% endfor %}
            - name: tmp-mem
              mountPath: /tmp
          resources:
            requests:
              cpu: {{ cpu_request | default(4) | tojson }}
              memory: {{ memory_request | default('16Gi') }}
            limits:
              cpu: {{ cpu_limit | default(8) | tojson }}
              memory: {{ memory_limit | default('32Gi') }}
      volumes:
{% for nfs in node_nfs_pvcs %}
        - name: nfs-{{ nfs.suffix }}
          persistentVolumeClaim:
            claimName: {{ nfs.pvc_name }}
{% endfor %}
        - name: tmp-mem
          emptyDir:
            medium: Memory
            sizeLimit: 8Gi
