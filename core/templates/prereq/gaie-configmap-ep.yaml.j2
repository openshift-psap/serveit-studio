apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ gaie_name | default('gaie-ep-epp') }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: {{ gaie_name | default('gaie-ep-epp') }}
    component: serveit-prereq
    architecture: ep
data:
  {{ config_file | default('ep-config.yaml') }}: |
    apiVersion: llm-d.ai/v1alpha1
    kind: EndpointPickerConfig
{% if spec_mode | default(false) %}
{{ spec_body_yaml }}{% else %}
    plugins:
      - type: approx-prefix-cache-producer
        parameters:
          maxPrefixBlocksToMatch: 256
          lruCapacityPerServer: 31250
      - type: prefix-cache-scorer
      - type: queue-scorer
      - type: prefill-filter
      - type: decode-filter
      - type: max-score-picker
      - type: prefix-based-pd-decider
        parameters:
          nonCachedTokens: 16
      - type: disagg-profile-handler
        parameters:
          deciders:
            prefill: prefix-based-pd-decider
{% if lora_affinity_enabled | default(false) %}
      - type: lora-affinity-scorer
{% endif %}
{% if session_aware_enabled | default(false) %}
{% if session_affinity_mode | default('filter') == 'scorer' %}
      - type: session-affinity-scorer
        parameters:
          strategy: session_id
{% else %}
      - type: session-affinity-filter
        parameters:
          strategy: session_id
{% endif %}
{% endif %}
    schedulingProfiles:
      - name: prefill
        plugins:
          - pluginRef: prefill-filter
{% if session_aware_enabled | default(false) %}
{% if session_affinity_mode | default('filter') == 'scorer' %}
          - pluginRef: session-affinity-scorer
            weight: {{ session_aware_weight | default(5.0) }}
{% else %}
          - pluginRef: session-affinity-filter
{% endif %}
{% endif %}
          - pluginRef: max-score-picker
          - pluginRef: prefix-cache-scorer
            weight: 2
          - pluginRef: queue-scorer
            weight: 1
{% if lora_affinity_enabled | default(false) %}
          - pluginRef: lora-affinity-scorer
            weight: {{ lora_affinity_weight | default(3.0) }}
{% endif %}

      - name: decode
        plugins:
          - pluginRef: decode-filter
{% if session_aware_enabled | default(false) %}
{% if session_affinity_mode | default('filter') == 'scorer' %}
          - pluginRef: session-affinity-scorer
            weight: {{ session_aware_weight | default(5.0) }}
{% else %}
          - pluginRef: session-affinity-filter
{% endif %}
{% endif %}
          - pluginRef: max-score-picker
          - pluginRef: prefix-cache-scorer
            weight: 2
          - pluginRef: queue-scorer
            weight: 1
{% if lora_affinity_enabled | default(false) %}
          - pluginRef: lora-affinity-scorer
            weight: {{ lora_affinity_weight | default(3.0) }}
{% endif %}

{% endif %}
