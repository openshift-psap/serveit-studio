apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ gaie_name | default('gaie-aggregated-epp') }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: {{ gaie_name | default('gaie-aggregated-epp') }}
    component: serveit-prereq
    architecture: aggregated
data:
  aggregated-config.yaml: |
    apiVersion: llm-d.ai/v1alpha1
    kind: EndpointPickerConfig
    plugins:
{% if slo_enabled | default(false) %}
      - type: slo-aware-profile-handler
      - type: slo-request-tracker
{% else %}
      - type: single-profile-handler
{% endif %}
      - type: prefix-cache-scorer
      - type: decode-filter
      - type: queue-scorer
{% if kv_cache_enabled | default(false) %}
      - type: kv-cache-utilization-scorer
{% endif %}
{% if slo_enabled | default(false) %}
      - type: latency-scorer
{% endif %}
{% if active_request_enabled | default(false) %}
      - type: active-request-scorer
{% endif %}
{% if no_hit_lru_enabled | default(false) %}
      - type: no-hit-lru-scorer
{% endif %}
{% if session_aware_enabled | default(false) %}
      - type: session-affinity-scorer
{% endif %}
      - type: max-score-picker
    schedulingProfiles:
      - name: default
        plugins:
          - pluginRef: decode-filter
          - pluginRef: max-score-picker
          - pluginRef: prefix-cache-scorer
            weight: {{ prefix_cache_weight | default(2.0) }}
          - pluginRef: queue-scorer
            weight: {{ queue_weight | default(1.0) }}
{% if kv_cache_enabled | default(false) %}
          - pluginRef: kv-cache-utilization-scorer
            weight: {{ kv_cache_weight | default(2.0) }}
{% endif %}
{% if slo_enabled | default(false) %}
          - pluginRef: slo-request-tracker
          - pluginRef: latency-scorer
            weight: {{ slo_weight | default(3.0) }}
{% endif %}
{% if active_request_enabled | default(false) %}
          - pluginRef: active-request-scorer
            weight: {{ active_request_weight | default(2.0) }}
{% endif %}
{% if no_hit_lru_enabled | default(false) %}
          - pluginRef: no-hit-lru-scorer
            weight: {{ no_hit_lru_weight | default(1.0) }}
{% endif %}
{% if session_aware_enabled | default(false) %}
          - pluginRef: session-affinity-scorer
            weight: {{ session_aware_weight | default(2.0) }}
{% endif %}
{% if slo_enabled | default(false) %}
      - name: slo
        plugins:
          - pluginRef: prefix-cache-scorer
            weight: 0
          - pluginRef: slo-request-tracker
          - pluginRef: latency-scorer
          - pluginRef: max-score-picker
{% endif %}
