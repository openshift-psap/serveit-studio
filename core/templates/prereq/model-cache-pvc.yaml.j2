apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ pvc_name | default('inferrecipe-model-cache') }}
  namespace: {{ namespace }}
  labels:
    app: llm-d
    component: inferrecipe-benchmark
    test-id: {{ test_id }}
  annotations:
    description: "Model cache PVC for InfeRecipe benchmark - {{ model_name }}"
spec:
  accessModes:
    - ReadWriteMany  # Required for shared access across pods
  storageClassName: {{ storage_class }}
  resources:
    requests:
      storage: {{ storage_size }}Gi
