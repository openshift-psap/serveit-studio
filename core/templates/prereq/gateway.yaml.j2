apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: {{ gateway_name | default('infra-pd-inference-gateway') }}
  namespace: {{ namespace }}
  labels:
    app: llm-d
    component: pd-disaggregation
    istio.io/enable-inference-extproc: "true"
spec:
  gatewayClassName: istio
  listeners:
    - name: default
      port: 80
      protocol: HTTP
      allowedRoutes:
        namespaces:
          from: All
