apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: llm-d-{{ architecture }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/component: {{ architecture }}
    app.kubernetes.io/name: llm-d
    deployment-type: {{ architecture }}
    component: serveit-prereq
  annotations:
    description: Routes inference requests from {{ architecture }} gateway to InferencePool
spec:
  parentRefs:
  - group: gateway.networking.k8s.io
    kind: Gateway
    name: infra-{{ architecture }}-inference-gateway
  rules:
  - backendRefs:
    - group: inference.networking.k8s.io
      kind: InferencePool
      name: gaie-{{ architecture }}
      port: 8000
      weight: 1
    matches:
    - path:
        type: PathPrefix
        value: /
    timeouts:
      backendRequest: 0s
      request: 0s
