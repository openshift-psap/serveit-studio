apiVersion: batch/v1
kind: Job
metadata:
  name: {{ job_name | default('serveit-model-download') }}
  namespace: {{ namespace }}
  labels:
    app: llm-d
    component: serveit-benchmark
    test-id: {{ test_id }}
  annotations:
    description: "Model download job for {{ model_name }}"
spec:
  backoffLimit: 3
  ttlSecondsAfterFinished: 10  # Auto-cleanup after 10 seconds
  template:
    metadata:
      labels:
        app: llm-d
        component: serveit-benchmark
        job: model-download
        test-id: {{ test_id }}
    spec:
      restartPolicy: OnFailure
{% if local_disk_path is defined and local_disk_path %}
      serviceAccountName: llm-d-modelserver
{% endif %}
{% if target_node is defined and target_node %}
      nodeSelector:
        kubernetes.io/hostname: {{ target_node }}
{% endif %}
{% if tolerate_all_taints is defined and tolerate_all_taints %}
      # Opt-in (DOWNLOAD_TOLERATE_ALL_TAINTS=true): tolerate every taint,
      # including tenant reservation taints — for shared clusters where
      # node-local model caches must be staged on tenant-dedicated nodes.
      tolerations:
        - operator: Exists
{% else %}
      # Default: tolerate transient node-condition taints only. A short
      # CPU+disk download job should ride out pressure states rather than
      # pile up Pending, but tenant reservation taints are respected.
      tolerations:
        - key: node.kubernetes.io/memory-pressure
          operator: Exists
          effect: NoSchedule
        - key: node.kubernetes.io/disk-pressure
          operator: Exists
          effect: NoSchedule
{% endif %}
      containers:
        - name: model-downloader
          image: {{ image | default('registry.access.redhat.com/ubi9/python-311:latest') }}
          imagePullPolicy: Always
{% if local_disk_path is defined and local_disk_path %}
          securityContext:
            privileged: true
            runAsUser: 0
            runAsGroup: 0
{% endif %}
          command:
            - /bin/bash
            - -c
          args:
            - |
              set -e
              echo "========================================="
              echo "ServeIt Studio Model Download Job"
              echo "Model: {{ model_name }}"
              echo "Cache Directory: /model-cache"
              echo "========================================="

              # Install huggingface_hub if not present
              pip3 install --quiet huggingface_hub

              # Use Python to download the model via huggingface_hub with progress tracking
              # Disable tqdm to prevent stderr output
              export HF_HUB_DISABLE_PROGRESS_BARS=1

              python3 -u <<'PYTHON_EOF'
              from huggingface_hub import snapshot_download, HfApi
              import os
              import sys
              import time
              import threading
              from pathlib import Path

              # Unbuffer output
              sys.stdout.reconfigure(line_buffering=True)
              sys.stderr.reconfigure(line_buffering=True)

              model_id = '{{ model_name }}'
              cache_dir = '/model-cache'
              token = os.getenv('HF_TOKEN')

              # Use None if token is empty or whitespace
              if not token or not token.strip():
                  token = None

              print(f'\n🔄 Downloading model: {model_id}', flush=True)
              print(f'📁 Cache directory: {cache_dir}\n', flush=True)

              try:
                  # Get model info to show file count
                  print('📊 Fetching model metadata...', flush=True)
                  api = HfApi(token=token)
                  try:
                      model_info = api.model_info(model_id)
                      files = [f for f in model_info.siblings if f.rfilename]
                      print(f'📦 Model contains {len(files)} files', flush=True)

                      # Show file list and calculate total size
                      total_size = 0
                      files_with_size = 0
                      for f in files:
                          if f.size:
                              total_size += f.size
                              files_with_size += 1

                      if files_with_size > 0:
                          total_size_gb = total_size / (1024**3)
                          print(f'💾 Total size: ~{total_size_gb:.2f} GB ({files_with_size}/{len(files)} files have size info)\n', flush=True)
                      else:
                          print(f'💾 Total size: Unknown (HuggingFace did not provide size metadata)\n', flush=True)
                          print(f'ℹ️  Progress below is based on file count, not bytes. Large weight shards may take much longer than small config files — 100% file count does not mean the download is fully written to disk.\n', flush=True)
                  except Exception as e:
                      print(f'⚠️ Could not fetch metadata: {e}', flush=True)

                  start_time = time.time()
                  print('📥 Starting download...\n', flush=True)

                  # Progress tracker - runs in background and counts downloaded files
                  download_complete = threading.Event()
                  expected_files = len(files) if 'files' in locals() else 0

                  # Convert model ID to cache directory name (e.g., RedHatAI/model -> models--RedHatAI--model)
                  model_cache_name = 'models--' + model_id.replace('/', '--')

                  def track_progress():
                      last_count = 0
                      while not download_complete.is_set():
                          time.sleep(3)
                          # Count files in model-specific cache directory only
                          try:
                              # HuggingFace cache structure: /model-cache/models--{owner}--{model}/blobs/
                              model_path = Path(cache_dir) / model_cache_name
                              if model_path.exists():
                                  # Count actual model files (blobs directory contains the downloaded files)
                                  blobs_path = model_path / 'blobs'
                                  if blobs_path.exists():
                                      file_count = sum(1 for _ in blobs_path.iterdir() if _.is_file())
                                      if file_count > last_count and expected_files > 0:
                                          percent = min(100, int(100 * file_count / expected_files))
                                          print(f'📥 Downloaded: {file_count}/{expected_files} files ({percent}%)', flush=True)
                                          last_count = file_count
                          except Exception:
                              pass

                  # Start progress tracker
                  if expected_files > 0:
                      progress_thread = threading.Thread(target=track_progress, daemon=True)
                      progress_thread.start()

                  # Download with progress disabled (we track manually)
                  snapshot_download(
                      repo_id=model_id,
                      cache_dir=cache_dir,
                      token=token if token else None,
                      max_workers=4,
                      local_files_only=False
                  )

                  # Stop progress tracker
                  download_complete.set()

                  elapsed = int(time.time() - start_time)
                  print(f'\n✅ Model download complete! (took {elapsed}s)', flush=True)

              except Exception as e:
                  print(f'\n❌ Error downloading model: {e}', flush=True)
                  import traceback
                  traceback.print_exc()
                  sys.exit(1)
              PYTHON_EOF

{% if lora_generate_adapters %}
              echo ""
              echo "🧩 Generating {{ lora_num_adapters }} LoRA adapters (rank {{ lora_rank | default(16) }}) on this PVC..."
              pip3 install --quiet safetensors numpy
              python3 -u <<'LORA_EOF'
              import json, sys
              from pathlib import Path
              import numpy as np
              from safetensors.numpy import save_file

              n = {{ lora_num_adapters }}
              rank = {{ lora_rank | default(16) }}
              model_id = '{{ model_name }}'
              out_root = Path('/model-cache/lora-adapters')

              # Derive adapter shapes from the downloaded model's config.json
              cfg_name = 'models--' + model_id.replace('/', '--')
              snaps = sorted((Path('/model-cache/huggingface') / cfg_name / 'snapshots').glob('*/config.json'))
              if not snaps:
                  print('❌ No model config found on cache — cannot derive adapter shapes', flush=True)
                  sys.exit(1)
              cfg = json.loads(snaps[0].read_text())
              tc = cfg.get('text_config', cfg)
              L = tc['num_hidden_layers']
              H = tc['hidden_size']
              heads = tc.get('num_attention_heads') or 1
              hd = tc.get('head_dim') or (H // heads)
              kv = tc.get('num_key_value_heads') or heads
              kv_out = max(kv * hd,
                           (tc.get('num_global_key_value_heads') or 0) * (tc.get('global_head_dim') or 0))
              prefix = 'base_model.model.language_model' if 'text_config' in cfg else 'base_model.model.model'

              meta_path = out_root / '.meta.json'
              if meta_path.exists():
                  try:
                      m = json.loads(meta_path.read_text())
                      if m.get('num_adapters') == n and m.get('rank') == rank and m.get('model') == model_id:
                          print(f'⏭️  {n} adapters (rank {rank}) already present — skipping generation', flush=True)
                          sys.exit(0)
                  except Exception:
                      pass

              rng = np.random.default_rng(42)
              shapes = {}
              for layer in range(L):
                  for m_name, out_d in (('q_proj', heads * hd), ('k_proj', kv_out),
                                        ('v_proj', kv_out), ('o_proj', H)):
                      shapes[f'{prefix}.layers.{layer}.self_attn.{m_name}.lora_A.weight'] = (rank, H)
                      shapes[f'{prefix}.layers.{layer}.self_attn.{m_name}.lora_B.weight'] = (out_d, rank)

              adapter_cfg = {
                  'alpha_pattern': {}, 'auto_mapping': None,
                  'base_model_name_or_path': model_id, 'bias': 'none',
                  'fan_in_fan_out': False, 'inference_mode': True,
                  'init_lora_weights': True, 'layer_replication': None,
                  'layers_pattern': None, 'layers_to_transform': None,
                  'loftq_config': {}, 'lora_alpha': rank * 2, 'lora_dropout': 0.0,
                  'megatron_config': None, 'megatron_core': 'megatron.core',
                  'modules_to_save': None, 'peft_type': 'LORA', 'r': rank,
                  'rank_pattern': {}, 'revision': None,
                  'target_modules': ['q_proj', 'k_proj', 'v_proj', 'o_proj'],
                  'task_type': 'CAUSAL_LM', 'use_dora': False, 'use_rslora': False,
              }

              out_root.mkdir(parents=True, exist_ok=True)
              size_bytes = 0
              for i in range(1, n + 1):
                  d = out_root / f'agent-{i:04d}'
                  d.mkdir(exist_ok=True)
                  (d / 'adapter_config.json').write_text(json.dumps(adapter_cfg))
                  data = {k: rng.standard_normal(s).astype(np.float16) for k, s in shapes.items()}
                  save_file(data, str(d / 'adapter_model.safetensors'))
                  size_bytes = (d / 'adapter_model.safetensors').stat().st_size
                  if i == 1 or i % 50 == 0 or i == n:
                      print(f'🧩 Generated adapter {i}/{n}', flush=True)

              meta_path.write_text(json.dumps({
                  'num_adapters': n, 'rank': rank, 'model': model_id,
                  'adapter_size_mb': round(size_bytes / 1e6, 1)}))
              print(f"✅ {n} LoRA adapters generated (rank {rank}, ~{round(size_bytes / 1e6, 1)}MB each)", flush=True)
              LORA_EOF
{% endif %}

              echo ""
              echo "📊 Cache directory size:"
              du -sh /model-cache 2>/dev/null || true
              echo ""
              echo "✅ Download job completed successfully"
          env:
            {% if hf_token %}
            - name: HF_TOKEN
              value: "{{ hf_token }}"
            {% else %}
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: llm-d-hf-token
                  key: HF_TOKEN
                  optional: true
            {% endif %}
            - name: HF_HUB_OFFLINE
              value: "0"
            - name: HF_HUB_CACHE
              value: /model-cache/huggingface
            - name: HF_HOME
              value: /model-cache/huggingface
          volumeMounts:
            - name: model-cache
              mountPath: /model-cache
            - name: tmp-mem
              mountPath: /tmp
          resources:
            requests:
              cpu: {{ cpu_request | default(4) | tojson }}
              memory: {{ memory_request | default('16Gi') }}
            limits:
              cpu: {{ cpu_limit | default(8) | tojson }}
              memory: {{ memory_limit | default('32Gi') }}
      volumes:
        - name: model-cache
{% if local_disk_path is defined and local_disk_path %}
          hostPath:
            path: {{ local_disk_path }}/model-cache
            type: DirectoryOrCreate
{% else %}
          persistentVolumeClaim:
            claimName: {{ pvc_name | default('serveit-cache') }}
{% endif %}
        - name: tmp-mem
          emptyDir:
            medium: Memory
            sizeLimit: 8Gi
