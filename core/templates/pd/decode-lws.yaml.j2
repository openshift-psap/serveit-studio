apiVersion: leaderworkerset.x-k8s.io/v1
kind: LeaderWorkerSet
metadata:
{% if per_node_storage %}
  name: decode-tp{{ decode_tp }}
{% else %}
  name: {{ test_id }}-decode
{% endif %}
  namespace: {{ namespace }}
  labels:
    app: llm-d
    component: serveit-test
    test-id: {{ test_id }}
    architecture: pd
    role: decode
spec:
  replicas: {{ decode_replicas or 1 }}
  leaderWorkerTemplate:
    size: {{ lws_size | default(1) }}
    leaderTemplate:
      metadata:
        labels:
          llm-d.ai/inferenceServing: "true"
          llm-d.ai/inference-serving: "true"
          llm-d.ai/model: {{ model_name_label }}
          llm-d.ai/role: decode
          llm-d.ai/guide: serveit-{{ architecture | default('pd') }}
          llm-d.ai/test-id: {{ test_id }}
{% if rdma_network_annotation %}
        annotations:
          k8s.v1.cni.cncf.io/networks: '{{ rdma_network_annotation }}'
{% endif %}
      spec: &decode_pod_spec
        serviceAccountName: llm-d-modelserver
        hostPID: true
{% if host_ipc %}        hostIPC: true  # User-selected hostIPC mode for /dev/shm unlimited access
{% endif %}
        {% if use_anti_affinity or selected_nodes %}
        affinity:
          {% if use_anti_affinity %}
          podAntiAffinity:
            requiredDuringSchedulingIgnoredDuringExecution:
              - labelSelector:
                  matchExpressions:
                  - key: llm-d.ai/inference-serving
                    operator: In
                    values:
                    - "true"
                  - key: llm-d.ai/role
                    operator: In
                    values:
                    - prefill
                topologyKey: kubernetes.io/hostname
          {% endif %}
          {% if selected_nodes %}
          nodeAffinity:
            requiredDuringSchedulingIgnoredDuringExecution:
              nodeSelectorTerms:
              - matchExpressions:
                - key: kubernetes.io/hostname
                  operator: In
                  values:
                  {% for node in selected_nodes %}
                  - "{{ node }}"
                  {% endfor %}
          {% endif %}
        {% endif %}
        tolerations:
          - key: node.kubernetes.io/disk-pressure
            operator: Exists
            effect: NoSchedule
          - key: node.kubernetes.io/memory-pressure
            operator: Exists
            effect: NoSchedule
        volumes:
          - name: dshm
            emptyDir:
              medium: Memory
              sizeLimit: {{ shm_size_gb }}Gi
{% if local_disk_path %}
          - name: hf-cache
            hostPath:
              path: {{ local_disk_path }}/model-cache
              type: DirectoryOrCreate
{% elif per_node_storage %}
          - name: hf-cache
            emptyDir: {}
{% for nfs in node_nfs_pvcs %}
          - name: nfs-{{ nfs.suffix }}
            persistentVolumeClaim:
              claimName: {{ nfs.pvc_name }}
{% endfor %}
{% else %}
          - name: hf-cache
            persistentVolumeClaim:
              claimName: {{ pvc_name }}
{% endif %}
          - name: jit-cache
            emptyDir: {}
{% if lora_enabled %}
{% if lora_adapters_use_pvc and not per_node_storage %}
          - name: lora-adapters
            persistentVolumeClaim:
              claimName: {{ pvc_name | default('serveit-cache') }}
              readOnly: false
{% elif not lora_adapters_use_pvc %}
          - name: lora-adapters
            hostPath:
              path: {{ lora_adapters_host_path }}
              type: DirectoryOrCreate
{% endif %}
{% endif %}
          - name: rdma-script
            configMap:
              name: rdma-discovery-script
              defaultMode: 0755
          - name: dev-infiniband
            hostPath:
              path: /dev/infiniband
{% if disk_offload_kv_path %}
          - name: kv-cache-disk
            hostPath:
              path: {{ disk_offload_kv_path }}
              type: DirectoryOrCreate
{% endif %}
        initContainers:
{% if per_node_storage and not local_disk_path %}
          - name: select-nfs
            image: busybox:stable
            resources:
              requests:
                cpu: "100m"
                memory: "64Mi"
              limits:
                cpu: "100m"
                memory: "64Mi"
            command: ["/bin/sh", "-c"]
            args:
              - |
                echo "Node: $NODE_NAME"
                case "$NODE_NAME" in
{% for nfs in node_nfs_pvcs %}
                  *{{ nfs.suffix }}*) ln -sf /nfs-{{ nfs.suffix }}/huggingface /model-cache/huggingface;{% if lora_enabled %} ln -sfn /adapters-{{ nfs.suffix }} /model-cache/adapters;{% endif %} echo "Linked to nfs-{{ nfs.suffix }}/huggingface" ;;
{% endfor %}
                  *) echo "ERROR: No NFS mount matches node $NODE_NAME"; ls -d /nfs-* 2>/dev/null; exit 1 ;;
                esac
            env:
              - name: NODE_NAME
                valueFrom:
                  fieldRef:
                    fieldPath: spec.nodeName
            volumeMounts:
              - name: hf-cache
                mountPath: /model-cache
{% for nfs in node_nfs_pvcs %}
              - name: nfs-{{ nfs.suffix }}
                mountPath: /nfs-{{ nfs.suffix }}
{% endfor %}
{% endif %}
          - name: routing-proxy
            image: {{ routing_proxy_image }}
            imagePullPolicy: Always
            args:
              - --port=8000
              - --model-server-port=8200
              - {{ sidecar_connector_flag | default('--kv-connector') }}=nixlv2
              - --zap-log-level=1
{% if epp_v011_plus | default(true) %}
              - --secure-proxy=false
{% endif %}
              - --enable-prefiller-sampling
{% if data_parallelism > 1 %}
              - --data-parallel-size={{ data_parallelism }}
{% endif %}
            ports:
              - containerPort: 8000
                name: {{ 'rank0' if data_parallelism > 1 else 'http' }}
                protocol: TCP
{% if data_parallelism > 1 %}
{% for i in range(1, data_parallelism) %}
              - containerPort: {{ 8000 + i }}
                name: rank{{ i }}
                protocol: TCP
{% endfor %}
{% endif %}
            restartPolicy: Always
            securityContext:
              allowPrivilegeEscalation: false
              runAsNonRoot: true
        containers:
          - name: vllm
            image: {{ image }}
            command:
              - /bin/bash
              - -c
            args:
              - |
                # Clear stale /dev/shm from previous container crashes (OffloadingConnector leaves large files)
                rm -f /dev/shm/vllm* /dev/shm/psm_* /dev/shm/cuda* 2>/dev/null || true
                ulimit -l unlimited || true

                # Pin to allocated GPUs (privileged pods see all host GPUs)
                if [ -d /var/run/nvidia-container-devices ]; then
                  GPU_INDICES=""
                  for uuid in $(ls /var/run/nvidia-container-devices/); do
                    idx=$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader | grep "$uuid" | cut -d',' -f1 | tr -d ' ')
                    [ -n "$idx" ] && GPU_INDICES="${GPU_INDICES:+$GPU_INDICES,}$idx"
                  done
                  if [ -n "$GPU_INDICES" ]; then
                    export CUDA_VISIBLE_DEVICES="$GPU_INDICES"
                    echo "--- CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES ---"
                  fi
                fi

                # Source RDMA discovery script if available
                if [ -f /scripts/discover_ib_hca.sh ]; then
                  source /scripts/discover_ib_hca.sh
                  echo "--- Loaded RDMA environment ---"
                fi

                echo "========================================="
                echo "ServeIt Studio Test: {{ test_id }}"
                echo "Architecture: PD (Decode)"
                echo "Model: {{ model_name }}"
                echo "TP: {{ decode_tp }}"
                echo "NCCL_IB_HCA: ${NCCL_IB_HCA}"
                echo "UCX_NET_DEVICES: ${UCX_NET_DEVICES:-not set}"
                echo "NCCL_SOCKET_IFNAME: ${NCCL_SOCKET_IFNAME:-not set}"
                echo "========================================="

                if [ -z "${UCX_NET_DEVICES:-}" ] || [ -z "${NCCL_IB_HCA:-}" ]; then
                  echo "FATAL: RDMA env vars not set (UCX_NET_DEVICES=${UCX_NET_DEVICES:-}, NCCL_IB_HCA=${NCCL_IB_HCA:-}). Sleeping to prevent node crash."
                  sleep infinity
                fi

                # Patch vllm#43396: FP8 MoE CUTLASS OOB at batch 8192
                _MOE_FILE=$(python3 -c "import vllm; print(vllm.__path__[0])" 2>/dev/null)/model_executor/layers/fused_moe/moe_permute_unpermute.py
                if [ -f "$_MOE_FILE" ] && grep -q 'a1q_scale\[permuted_idx.clamp' "$_MOE_FILE"; then
                  sed -i 's|a1q_scale = a1q_scale\[permuted_idx.clamp(max=n_token \* topk - 1) // topk\]|scale_idx = permuted_idx.clamp(max=n_token * topk - 1) // topk; scale_idx = scale_idx.clamp(max=a1q_scale.shape[0] - 1); a1q_scale = a1q_scale[scale_idx]|' "$_MOE_FILE"
                  echo "--- Applied vllm#43396 FP8 MoE patch ---"
                fi

                # Patch transformers 5.15+ AmbiguousGlobalPerLayerAttributeError for heterogeneous models (Gemma 4)
                printf '#!/usr/bin/env python3\ntry:\n import transformers.integrations.heterogeneity.configuration_utils as _hc\n _p=_hc.HeterogeneousConfigMixin.allow_global_per_layer_attribute_access\n _hc.HeterogeneousConfigMixin.allow_global_per_layer_attribute_access=property(lambda s:s.__dict__.get("allow_global_per_layer_attribute_access",True),_p.fset)\nexcept Exception:\n pass\n{% if lws_size | default(1) > 1 %}try:\n import vllm.distributed.device_communicators.flashinfer_all_reduce as _fia\n _fia.fi_ar_available=False\nexcept Exception:\n pass\ntry:\n import vllm.models.common.ops.fused_allreduce_rms_norm as _far\n _far.flashinfer_trtllm_fused_allreduce_norm=None\n _far.get_fi_ar_workspace=None\nexcept Exception:\n pass\n{% endif %}if __name__=="__main__":\n import sys;sys.argv[0]="vllm"\n from vllm.entrypoints.cli.main import main;main()\n' > /tmp/_vllm_patched && chmod +x /tmp/_vllm_patched
                echo "--- Patched transformers per-layer attribute access ---"

                # KV cache check patch disabled - not needed when max_model_len fits GPU budget
                # (Re-enable if using cpu_offload_gb for 1M+ context)
                #_KV_FILE=$(python3 -c "import vllm; print(vllm.__path__[0])" 2>/dev/null)/v1/core/kv_cache_utils.py
                #if [ -f "$_KV_FILE" ] && grep -q '_check_enough_kv_cache_memory' "$_KV_FILE"; then
                #  echo "..." | base64 -d | python3
                #fi

                # Set --headless flag for multi-node worker nodes (LWS_WORKER_INDEX > 0)
                # Wait for the GPU to drain before launching vLLM — a previous
                # container's orphaned EngineCore can hold ~126GiB after
                # RecreateGroupOnPodRestart replaces the pod; starting against it
                # fails init_device ("Free memory ... less than desired") and
                # crash-loops. This pod owns its DRA-claimed GPU, so any OTHER
                # process on it is a leftover from a deleted container — kill it
                # (requires hostPID) instead of waiting for a holder that never
                # exits. Poll the minimum free MiB across visible GPUs.
                # Pin the drain check to THIS pod's claimed GPUs. Privileged
                # pods see every GPU on the node — an unfiltered minimum-free
                # check reads sibling pods' engines as "leftovers" once the
                # node fills up, and the kill loop then murders them
                # (observed at 8xTP1: every newly started pod killed an
                # established engine every 60s — mutual destruction).
                _own_gpu_memfree() {
                  # CUDA_VISIBLE_DEVICES holds the DRA-pinned indices
                  if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then
                    nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits 2>/dev/null \
                      | awk -F, -v devs="$CUDA_VISIBLE_DEVICES" 'BEGIN{n=split(devs,a,",");for(i=1;i<=n;i++)want[a[i]]=1} want[$1]{gsub(/ /,"",$2);print $2}'
                  else
                    nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | tr -d ' '
                  fi
                }
                _own_gpu_pids() {
                  # compute apps whose GPU UUID belongs to one of OUR GPUs
                  if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then
                    _uuids=$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader 2>/dev/null \
                      | awk -F, -v devs="$CUDA_VISIBLE_DEVICES" 'BEGIN{n=split(devs,a,",");for(i=1;i<=n;i++)want[a[i]]=1} want[$1]{gsub(/ /,"",$2);print $2}')
                    nvidia-smi --query-compute-apps=gpu_uuid,pid --format=csv,noheader 2>/dev/null \
                      | awk -F, -v u="$_uuids" 'BEGIN{n=split(u,a," ");for(i=1;i<=n;i++)want[a[i]]=1} want[$1]{gsub(/ /,"",$2);print $2}'
                  else
                    nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null | tr -d ' '
                  fi
                }
                if command -v nvidia-smi >/dev/null 2>&1; then
                  # Killing is only safe with PROVEN ownership (CUDA_VISIBLE_DEVICES
                  # pinned by the device plugin). DRA pods don't get that pinning;
                  # without it: wait only, never signal.
                  if [ -z "${CUDA_VISIBLE_DEVICES:-}" ]; then
                    _gpu_wait=0
                    while [ "$_gpu_wait" -lt 120 ]; do
                      _free=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | sort -n | head -1 | tr -d ' ')
                      if [ -n "$_free" ] && [ "$_free" -ge 120000 ]; then
                        break
                      fi
                      echo "--- Waiting for GPU memory (no pinning; observing only): ${_free:-?} MiB free, ${_gpu_wait}s ---"
                      sleep 10
                      _gpu_wait=$((_gpu_wait+10))
                    done
                  else
                    _gpu_wait=0
                    while [ "$_gpu_wait" -lt 180 ]; do
                      _free=$(_own_gpu_memfree | sort -n | head -1)
                      if [ -n "$_free" ] && [ "$_free" -ge 120000 ]; then
                        break
                      fi
                      if [ $((_gpu_wait % 60)) -eq 0 ]; then
                        for _hp in $(_own_gpu_pids | sort -u); do
                          if [ -n "$_hp" ] && [ "$_hp" != "$$" ] && kill -0 "$_hp" 2>/dev/null; then
                            kill -9 "$_hp" 2>/dev/null && echo "--- Killed leftover GPU holder pid $_hp ---"
                          fi
                        done
                      fi
                      echo "--- Waiting for GPU to drain (${_free:-?} MiB free, ${_gpu_wait}s) ---"
                      sleep 5
                      _gpu_wait=$((_gpu_wait+5))
                    done
                  fi
                fi

{% if lora_enabled %}
                # Dynamically ensure adapter files exist for this level's count —
                # the sweep may mount more than setup generated. Seeded RNG, so
                # every pod generates identical bytes; flock + atomic rename
                # serialize concurrent generation on the shared storage.
                python3 - <<'LORA_GEN_EOF'
                import json, os, sys, fcntl
                from pathlib import Path
                import numpy as np
                from safetensors.numpy import save_file

                n = {{ lora_adapter_count }}
                rank = {{ lora_max_rank }}
                model_id = '{{ model_name }}'
                out_root = Path('{{ lora_adapters_path }}')

                cfg_name = 'models--' + model_id.replace('/', '--')
                snaps = sorted((Path('/model-cache/huggingface') / cfg_name / 'snapshots').glob('*/config.json'))
                if not snaps:
                    print('LORA_GEN: no model config found — cannot derive adapter shapes', flush=True)
                    sys.exit(1)
                cfg = json.loads(snaps[0].read_text())
                tc = cfg.get('text_config', cfg)
                L = tc['num_hidden_layers']
                H = tc['hidden_size']
                heads = tc.get('num_attention_heads') or 1
                hd = tc.get('head_dim') or (H // heads)
                kv = tc.get('num_key_value_heads') or heads
                kv_out = max(kv * hd,
                             (tc.get('num_global_key_value_heads') or 0) * (tc.get('global_head_dim') or 0))
                prefix = 'base_model.model.language_model' if 'text_config' in cfg else 'base_model.model.model'

                missing = [i for i in range(1, n + 1)
                           if not (out_root / f'agent-{i:04d}' / 'adapter_model.safetensors').exists()]
                if not missing:
                    print(f'LORA_GEN: all {n} adapters present', flush=True)
                else:
                    print(f'LORA_GEN: generating {len(missing)} missing adapters (of {n})', flush=True)
                    rng = np.random.default_rng(42)
                    shapes = {}
                    for layer in range(L):
                        for m_name, out_d in (('q_proj', heads * hd), ('k_proj', kv_out),
                                              ('v_proj', kv_out), ('o_proj', H)):
                            shapes[f'{prefix}.layers.{layer}.self_attn.{m_name}.lora_A.weight'] = (rank, H)
                            shapes[f'{prefix}.layers.{layer}.self_attn.{m_name}.lora_B.weight'] = (out_d, rank)
                    adapter_cfg = json.dumps({
                        'peft_type': 'LORA', 'r': rank, 'lora_alpha': rank * 2,
                        'target_modules': ['q_proj', 'k_proj', 'v_proj', 'o_proj'],
                        'task_type': 'CAUSAL_LM', 'base_model_name_or_path': model_id,
                        'bias': 'none', 'inference_mode': True, 'init_lora_weights': True,
                        'lora_dropout': 0.0, 'fan_in_fan_out': False,
                        'use_dora': False, 'use_rslora': False})
                    out_root.mkdir(parents=True, exist_ok=True)
                    with open(out_root / '.gen.lock', 'w') as lf:
                        fcntl.flock(lf, fcntl.LOCK_EX)
                        try:
                            for i in missing:
                                d = out_root / f'agent-{i:04d}'
                                d.mkdir(exist_ok=True)
                                (d / 'adapter_config.json').write_text(adapter_cfg)
                                data = {k: rng.standard_normal(s).astype(np.float16)
                                        for k, s in shapes.items()}
                                tmp = d / '.adapter_model.tmp'
                                save_file(data, str(tmp))
                                os.replace(tmp, d / 'adapter_model.safetensors')
                                if i % 100 == 0 or i == missing[-1]:
                                    print(f'LORA_GEN: {i}/{n}', flush=True)
                        finally:
                            fcntl.flock(lf, fcntl.LOCK_UN)
                    print(f'LORA_GEN: done — {n} adapters ready', flush=True)
                LORA_GEN_EOF

{% endif %}
                /tmp/_vllm_patched serve {{ model_name }} \
                  --port 8200 \
                  --trust-remote-code \
{% if vllm_log_request_flag %}                  {{ vllm_log_request_flag }} \
{% endif %}                  --tensor-parallel-size ${TP_SIZE} \
{% if lws_size | default(1) > 1 %}                  --nnodes {{ lws_size }} \
                  --node-rank ${LWS_WORKER_INDEX:-0} \
                  --master-addr ${LWS_LEADER_ADDRESS} \
{% endif %}                  --data-parallel-size ${DP_SIZE} \
{% if data_parallelism > 1 %}                  --data-parallel-size-local ${DP_SIZE_LOCAL} \
                  --data-parallel-multi-port-external-lb \
                  --data-parallel-supervisor-port=8208 \
                  --data-parallel-start-rank $(( ${LWS_WORKER_INDEX:-0} * DP_SIZE_LOCAL )) \
{% endif %}{% if pipeline_parallel_size %}                  --pipeline-parallel-size {{ pipeline_parallel_size }} \
{% endif %}{% if context_parallel_size and context_parallel_size > 1 %}                  --context-parallel-size {{ context_parallel_size }} \
{% endif %}{% if decode_context_parallel_size and decode_context_parallel_size > 1 %}                  --decode-context-parallel-size {{ decode_context_parallel_size }} \
{% endif %}
{% if block_size %}                  --block-size {{ block_size }} \
{% endif %}
{% if decode_gpu_memory_utilization %}                  --gpu-memory-utilization {{ decode_gpu_memory_utilization }} \
{% endif %}
{% if decode_max_num_batched_tokens or max_num_batched_tokens %}                  --max-num-batched-tokens {{ decode_max_num_batched_tokens or max_num_batched_tokens }} \
{% endif %}
{% if decode_max_num_seqs or max_num_seqs %}                  --max-num-seqs {{ decode_max_num_seqs or max_num_seqs }} \
{% endif %}
{% if cpu_offload_gb or disk_offload_kv_path %}                  --kv-transfer-config '{"kv_connector":"MultiConnector","kv_role":"kv_both","kv_load_failure_policy":"fail","kv_connector_extra_config":{"connectors":[{"kv_connector":"NixlConnector","kv_role":"kv_consumer","kv_connector_extra_config":{"bidirectional_kv_xfer":{{ "true" if enable_bidirectional_kv else "false" }},"enforce_handshake_compat":false}},{"kv_connector":"OffloadingConnector","kv_role":"kv_both","kv_connector_extra_config":{% if disk_offload_kv_path %}{"spec_name":"TieringOffloadingSpec","block_size":16,"eviction_policy":"lru","secondary_tiers":[{"type":"fs","root_dir":"{{ disk_offload_kv_path }}","n_read_threads":{{ disk_offload_kv_read_threads | default(32) }},"n_write_threads":{{ disk_offload_kv_write_threads | default(16) }}}]}{% else %}{"cpu_bytes_to_use":{{ cpu_offload_gb * 1073741824 }},"lazy_offload":true}{% endif %}}]}}' \
{% else %}                  --kv-transfer-config '{"kv_connector":"{{ kv_connector }}","kv_role":"kv_both","kv_load_failure_policy":"fail","kv_connector_extra_config":{{ '{' }}{% if enable_bidirectional_kv %}"bidirectional_kv_xfer":true,{% endif %}"enforce_handshake_compat":false}}' \
{% endif %}{% if has_hybrid_attention %}                  --no-disable-hybrid-kv-cache-manager \
{% endif %}{% if kv_cache_memory_bytes %}                  --kv-cache-memory-bytes={{ kv_cache_memory_bytes }} \
{% endif %}{% if decode_enable_expert_parallel %}                  --enable-expert-parallel \
{% endif %}{% if enable_ep_weight_filter %}                  --enable-ep-weight-filter \
{% endif %}{% if decode_enable_dbo %}                  --enable-dbo \
                  --dbo-decode-token-threshold {{ dbo_decode_token_threshold | default(32) }} \
{% endif %}{% if decode_enable_eplb %}                  --enable-eplb \
                  --eplb-config '{"window_size":"1000","step_interval":"3000","num_redundant_experts":"{{ num_redundant_experts | default(1) }}","log_balancedness":"False"}' \
{% endif %}{% if decode_moe_backend %}                  --moe-backend {{ decode_moe_backend }} \
{% endif %}{% if decode_all2all_backend %}                  --all2all-backend {{ decode_all2all_backend }} \
{% endif %}{% if max_model_len %}                  --max-model-len {{ max_model_len }} \
{% endif %}{% if enable_prefix_caching %}                  --enable-prefix-caching \
{% endif %}{% if disable_custom_all_reduce %}                  --disable-custom-all-reduce \
{% endif %}{% if dtype %}                  --dtype {{ dtype }} \
{% endif %}{% if kv_cache_dtype %}                  --kv-cache-dtype {{ kv_cache_dtype }} \
{% endif %}{% if speculative_config_json %}                  --speculative-config '{{ speculative_config_json }}' \
{% endif %}{% if decode_enable_scale_out %}                  --enable-scale-out \
                  --safetensors-load-strategy lazy \
                  --long-prefill-token-threshold {{ long_prefill_token_threshold | default(2048) }} \
{% endif %}{% if decode_compilation_config %}                  --compilation-config '{{ decode_compilation_config }}' \
{% endif %}{% if enable_auto_tool_choice %}                  --enable-auto-tool-choice \
{% endif %}{% if tool_call_parser %}                  --tool-call-parser {{ tool_call_parser }} \
{% endif %}{% if reasoning_parser %}                  --reasoning-parser {{ reasoning_parser }} \
{% endif %}{% if chat_template_content_format %}                  --chat-template-content-format {{ chat_template_content_format }} \
{% endif %}{% if weight_cpu_offload_gb %}                  --cpu-offload-gb {{ weight_cpu_offload_gb }} \
{% endif %}{% if model_loader_extra_config %}                  --model-loader-extra-config '{{ model_loader_extra_config }}' \
{% endif %}{% if override_generation_config %}                  --override-generation-config '{{ override_generation_config }}' \
{% endif %}{% if attention_config %}                  --attention-config '{{ attention_config }}' \
{% endif %}{% if lora_enabled %}                  --enable-lora \
                  --max-lora-rank {{ lora_max_rank }} \
                  --max-loras {{ lora_max_loras }} \
                  --max-cpu-loras {{ lora_max_cpu_loras }} \
                  --lora-modules {{ lora_modules_arg }} \
{% endif %}{% if extra_vllm_args %}                  {{ extra_vllm_args }} \
{% endif %}
                  || sleep infinity
            env:
              - name: VLLM_NIXL_SIDE_CHANNEL_HOST
                valueFrom:
                  fieldRef:
                    fieldPath: status.podIP
              - name: VLLM_METRICS_PORT
                value: "8200"
{% if selected_dra_classes %}
              - name: RDMA_NETWORK_MODE
                value: "dra-net"
{% endif %}
              - name: NCCL_IB_HCA
                value: "{{ nccl_ib_hca }}"
              - name: HF_TOKEN
                valueFrom:
                  secretKeyRef:
                    name: llm-d-hf-token
                    key: HF_TOKEN
                    optional: true
              - name: HF_HOME
                value: "/model-cache/huggingface"
              - name: HF_HUB_CACHE
                value: "/model-cache/huggingface"
              - name: HF_HUB_OFFLINE
                value: "1"
              - name: VLLM_SKIP_P2P_CHECK
                value: "1"
              - name: NVIDIA_GDRCOPY
                value: "enabled"
              - name: VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS
                value: "1"
              - name: GLOO_SOCKET_IFNAME
                value: "eth0"
              - name: NCCL_SOCKET_IFNAME
                value: "eth0"
{% if lws_size | default(1) > 1 %}
              # Multi-node NCCL workarounds (validated on H200 + driver 595.71.05,
              # NCCL 2.28.3): Ring/Simple avoids cross-node NVLS heads; GDR off
              # avoids RDMA failures on this fabric. No CUDA_LAUNCH_BLOCKING and
              # no --enforce-eager — CUDA graphs stay enabled: the capture-phase
              # hangs observed during debugging predated the worker config-parity
              # fix, and single-node capture works on this driver.
              - name: NCCL_ALGO
                value: "Ring"
              - name: NCCL_PROTO
                value: "Simple"
              - name: NCCL_IB_GDR
                value: "0"
{% endif %}
{% if use_deep_gemm is not none %}
              - name: VLLM_USE_DEEP_GEMM
                value: "{{ '1' if use_deep_gemm else '0' }}"
{% endif %}
{% if decode_enable_expert_parallel %}
              - name: VLLM_RANDOMIZE_DP_DUMMY_INPUTS
                value: "1"
              - name: VLLM_MOE_DP_CHUNK_SIZE
                value: "{{ moe_dp_chunk_size | default(384) }}"
              - name: NVSHMEM_REMOTE_TRANSPORT
                value: "ibgda"
              - name: NVSHMEM_IB_ENABLE_IBGDA
                value: "true"
              - name: NVSHMEM_DISABLE_CUDA_VMM
                value: "0"
              - name: NVSHMEM_SYMMETRIC_SIZE
                value: "{{ nvshmem_symmetric_size | default('16G') }}"
              - name: NVSHMEM_BOOTSTRAP_UID_SOCK_IFNAME
                value: "eth0"
{% endif %}
              - name: VLLM_LOGGING_LEVEL
                value: "{{ 'DEBUG' if vllm_debug_logs else 'ERROR' }}"
              - name: NCCL_DEBUG
                value: "{{ 'INFO' if nccl_debug_logs else 'ERROR' }}"
              - name: TRITON_LIBCUDA_PATH
                value: /usr/lib64
              - name: CUDA_CACHE_PATH
                value: /var/cache/vllm/cuda
              - name: CCACHE_DIR
                value: /var/cache/vllm/ccache
              - name: VLLM_CACHE_ROOT
                value: /var/cache/vllm/vllm
              - name: FLASHINFER_WORKSPACE_BASE
                value: /var/cache/vllm/flashinfer
              - name: VLLM_NIXL_ABORT_REQUEST_TIMEOUT
                value: "600"
              - name: SHARED_STORAGE_PATH
                value: "/data"
              - name: TP_SIZE
                value: "{{ decode_tp }}"
              - name: DP_SIZE
                value: "{{ data_parallelism }}"
              - name: DP_SIZE_LOCAL
                value: "{{ data_parallel_size_local | default(data_parallelism) }}"
{% if http_timeout_keep_alive %}
              - name: VLLM_HTTP_TIMEOUT_KEEP_ALIVE
                value: "{{ http_timeout_keep_alive }}"
{% endif %}
{% if prefix_cache_retention is not none %}
              - name: VLLM_PREFIX_CACHE_RETENTION_INTERVAL
                value: "{{ prefix_cache_retention }}"
{% endif %}
{% if ssm_conv_state_layout %}
              - name: VLLM_SSM_CONV_STATE_LAYOUT
                value: "{{ ssm_conv_state_layout }}"
{% endif %}
{% if extra_env_vars %}{% for env in extra_env_vars %}
              - name: {{ env.name }}
                value: "{{ env.value }}"
{% endfor %}{% endif %}
            ports:
              - containerPort: 8200
                name: {{ 'vllm-rank0' if data_parallelism > 1 else 'vllm' }}
{% if data_parallelism > 1 %}
{% for i in range(1, data_parallelism) %}
              - containerPort: {{ 8200 + i }}
                name: vllm-rank{{ i }}
{% endfor %}
              - containerPort: 8208
                name: supervisor
{% endif %}
              - containerPort: 5600
                name: nixl
            startupProbe:
              httpGet:
                path: /v1/models
                port: 8200
              initialDelaySeconds: 15
              periodSeconds: 30
              timeoutSeconds: 5
              failureThreshold: 120
            livenessProbe:
              httpGet:
                path: /health
                port: 8200
              periodSeconds: 10
              timeoutSeconds: 5
              failureThreshold: 3
            readinessProbe:
              httpGet:
                path: /v1/models
                port: 8200
              periodSeconds: 5
              timeoutSeconds: 2
              failureThreshold: 3
            securityContext:
              runAsUser: 0
              privileged: true
              capabilities:
                add:
                  - "IPC_LOCK"
                  - "SYS_RAWIO"
                  - "SYS_RESOURCE"
            resources:
              limits:
                cpu: "{{ cpu_limit }}"
                memory: "{{ memory_limit }}"
{% if selected_dra_classes %}
                {{ gpu_resource_key }}: "{{ decode_gpu_count }}"
{% else %}
                {{ gpu_resource_key }}: "{{ decode_gpu_count }}"
                {% for r in decode_extra_device_resources %}
                {{ r.key }}: "{{ r.value }}"
                {% endfor %}
{% endif %}
              requests:
                cpu: "{{ cpu_limit }}"
                memory: "{{ memory_limit }}"
{% if selected_dra_classes %}
                {{ gpu_resource_key }}: "{{ decode_gpu_count }}"
{% else %}
                {{ gpu_resource_key }}: "{{ decode_gpu_count }}"
                {% for r in decode_extra_device_resources %}
                {{ r.key }}: "{{ r.value }}"
                {% endfor %}
{% endif %}
            volumeMounts:
              - name: dshm
                mountPath: /dev/shm
              - name: hf-cache
                mountPath: /model-cache
              - name: jit-cache
                mountPath: /var/cache/vllm
{% if lora_enabled %}
{% if lora_adapters_use_pvc and per_node_storage %}
{% for nfs in node_nfs_pvcs %}
              - name: nfs-{{ nfs.suffix }}
                mountPath: /adapters-{{ nfs.suffix }}
                subPath: lora-adapters
                readOnly: false
{% endfor %}
{% else %}
              - name: lora-adapters
                mountPath: /adapters
{% if lora_adapters_use_pvc %}
                subPath: lora-adapters
{% endif %}
{% endif %}
{% endif %}
              - name: rdma-script
                mountPath: /scripts
              - name: dev-infiniband
                mountPath: /dev/infiniband
{% if disk_offload_kv_path %}
              - name: kv-cache-disk
                mountPath: {{ disk_offload_kv_path }}
{% endif %}
{% if per_node_storage and not local_disk_path %}
{% for nfs in node_nfs_pvcs %}
              - name: nfs-{{ nfs.suffix }}
                mountPath: /nfs-{{ nfs.suffix }}
{% endfor %}
{% endif %}
    workerTemplate:
{% if lws_size | default(1) > 1 %}
      spec: *decode_pod_spec
{% else %}
      spec:
        containers: []
{% endif %}
