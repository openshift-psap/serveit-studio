apiVersion: v1
kind: Pod
metadata:
  name: serveit-workload
  namespace: {{ namespace }}
  labels:
    component: serveit-benchmark
    app: serveit-workload
spec:
  serviceAccountName: llm-d-modelserver
  restartPolicy: Never
  containers:
  - name: guidellm
    image: {{ image }}
    command: ["sleep", "infinity"]
    env:
    - name: HF_HOME
      value: "/mnt/storage/.cache/huggingface"
    - name: HF_DATASETS_CACHE
      value: "/mnt/storage/.cache/huggingface/datasets"
    - name: TRANSFORMERS_CACHE
      value: "/mnt/storage/.cache/huggingface/transformers"
    - name: HF_TOKEN
{% if hf_token %}
      value: "{{ hf_token }}"
{% else %}
      valueFrom:
        secretKeyRef:
          name: llm-d-hf-token
          key: HF_TOKEN
          optional: true
{% endif %}
    resources:
      requests:
        cpu: "1"
        memory: "2Gi"
      limits:
        cpu: "4"
        memory: "12Gi"
    volumeMounts:
    - name: storage
      mountPath: /mnt/storage
  volumes:
  - name: storage
    persistentVolumeClaim:
      claimName: {{ pvc_name }}
