apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
  labels:
    app: {{ name }}
    component: inferecipe-instance
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: {{ name }}
  template:
    metadata:
      labels:
        app: {{ name }}
        component: inferecipe-instance
    spec:
      serviceAccountName: default
      volumes:
        - name: storage-volume
          persistentVolumeClaim:
            claimName: {{ pvc_name }}
{% if code_pvc_name %}
        - name: code-volume
          persistentVolumeClaim:
            claimName: {{ code_pvc_name }}
{% endif %}
        - name: tmp-mem
          emptyDir:
            medium: Memory
            sizeLimit: 4Gi
{% if has_kubeconfig == 'true' %}
        - name: kubeconfig
          secret:
            secretName: {{ kubeconfig_secret }}
{% endif %}
      containers:
        - name: runner
          image: {{ image }}
          imagePullPolicy: Always
          command:
            - "/bin/sh"
            - "-c"
            - |
              echo "--- Starting InfeRecipe Instance ---"
              if [ -f "/mnt/code/app/web/server.py" ]; then
                echo "Using code from shared code PVC"
                export INFE_RECIPE_PATH="/mnt/code/app"
                cd /mnt/code/app/web
              elif [ -f "/mnt/storage/app/web/server.py" ]; then
                echo "Using code from storage PVC"
                export INFE_RECIPE_PATH="/mnt/storage/app"
                cd /mnt/storage/app/web
              else
                echo "Using code from image"
                cd /app/web
              fi
              exec python3.11 server.py
          env:
            - name: INFE_RECIPE_PATH
              value: "/app"
            - name: OPTIMIZATION_OUTPUT_DIR
              value: "/mnt/storage/optimization-runs"
            - name: HOME_STORAGE_DIR
              value: "/mnt/storage"
            - name: TARGET_NAMESPACE
              value: "{{ workload_namespace }}"
            - name: DB_PATH
              value: "/mnt/storage/inferecipe.db"
            - name: AUTH_DISABLED
              value: "{{ auth_disabled }}"
            - name: INFE_RECIPE_FORCE_NAD
              value: "{{ force_nad }}"
            - name: DEV_MODE
              value: "{{ dev_mode }}"
{% if has_kubeconfig == 'true' %}
            - name: KUBECONFIG
              value: "/etc/kubeconfig/kubeconfig"
{% endif %}
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: inferecipe-optimizer-hf-token
                  key: HF_TOKEN
                  optional: true
          volumeMounts:
            - name: storage-volume
              mountPath: /mnt/storage
{% if code_pvc_name %}
            - name: code-volume
              mountPath: /mnt/code
              readOnly: true
{% endif %}
            - name: tmp-mem
              mountPath: /tmp
{% if has_kubeconfig == 'true' %}
            - name: kubeconfig
              mountPath: /etc/kubeconfig
              readOnly: true
{% endif %}
          ports:
            - containerPort: 5000
          resources:
            requests:
              memory: "2Gi"
              cpu: "1000m"
