apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
  labels:
    app: {{ name }}
    component: inferecipe-instance
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: {{ name }}
  template:
    metadata:
      labels:
        app: {{ name }}
        component: inferecipe-instance
    spec:
      serviceAccountName: default
      volumes:
        - name: storage-volume
          persistentVolumeClaim:
            claimName: {{ pvc_name }}
        - name: tmp-mem
          emptyDir:
            medium: Memory
            sizeLimit: 4Gi
{% if has_kubeconfig == 'true' %}
        - name: kubeconfig
          secret:
            secretName: {{ kubeconfig_secret }}
{% endif %}
      containers:
        - name: runner
          image: {{ image }}
          imagePullPolicy: Always
          command:
            - "/bin/sh"
            - "-c"
            - |
              echo "--- Starting InfeRecipe Instance ---"
              cd /app && git pull --ff-only 2>/dev/null || true
              while true; do
                cd /app/web
                find /app -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
                python3.11 server.py || true
                echo "Server exited, restarting in 3s..."
                sleep 3
              done
          env:
            - name: INFE_RECIPE_PATH
              value: "/app"
            - name: OPTIMIZATION_OUTPUT_DIR
              value: "/mnt/storage/optimization-runs"
            - name: HOME_STORAGE_DIR
              value: "/mnt/storage"
            - name: TARGET_NAMESPACE
              value: "{{ workload_namespace }}"
            - name: DB_PATH
              value: "/mnt/storage/inferecipe.db"
            - name: AUTH_DISABLED
              value: "{{ auth_disabled }}"
            - name: INFE_RECIPE_FORCE_NAD
              value: "{{ force_nad }}"
            - name: DEV_MODE
              value: "{{ dev_mode }}"
{% if has_kubeconfig == 'true' %}
            - name: KUBECONFIG
              value: "/etc/kubeconfig/kubeconfig"
{% endif %}
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: inferecipe-optimizer-hf-token
                  key: HF_TOKEN
                  optional: true
          volumeMounts:
            - name: storage-volume
              mountPath: /mnt/storage
            - name: tmp-mem
              mountPath: /tmp
{% if has_kubeconfig == 'true' %}
            - name: kubeconfig
              mountPath: /etc/kubeconfig
              readOnly: true
{% endif %}
          ports:
            - containerPort: 5000
          resources:
            requests:
              memory: "2Gi"
              cpu: "1000m"
